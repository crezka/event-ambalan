    <!-- Scripts for interactivity -->
    <script>
        // ==========================================
        // SCRIPT: LOGIKA SALJU (SNOW CANVAS)
        // ==========================================
        const canvas = document.getElementById('snowCanvas');
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;
        let particles = [];
        let isSnowing = false;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        for(let i = 0; i < 100; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                r: Math.random() * 3 + 1, 
                d: Math.random() * 100 
            });
        }

        function drawSnow() {
            if (!isSnowing) return;
            ctx.clearRect(0, 0, width, height);
            ctx.fillStyle = "rgba(255, 255, 255, 0.7)";
            ctx.beginPath();
            for(let i = 0; i < 100; i++) {
                let p = particles[i];
                ctx.moveTo(p.x, p.y);
                ctx.arc(p.x, p.y, p.r, 0, Math.PI*2, true);
            }
            ctx.fill();
            updateSnow();
            requestAnimationFrame(drawSnow);
        }

        let angle = 0;
        function updateSnow() {
            angle += 0.01;
            for(let i = 0; i < 100; i++) {
                let p = particles[i];
                p.y += Math.cos(angle + p.d) + 1 + p.r/2;
                p.x += Math.sin(angle) * 2;

                if(p.x > width + 5 || p.x < -5 || p.y > height) {
                    if(i % 3 > 0) {
                        particles[i] = {x: Math.random() * width, y: -10, r: p.r, d: p.d};
                    } else {
                        if(Math.sin(angle) > 0) {
                            particles[i] = {x: -5, y: Math.random() * height, r: p.r, d: p.d};
                        } else {
                            particles[i] = {x: width + 5, y: Math.random() * height, r: p.r, d: p.d};
                        }
                    }
                }
            }
        }

        // ==========================================
        // FUNGSI MEMBUKA PINTU 3D & MEMICU AUDIO/SALJU
        // ==========================================
        function handleOpenDoor() {
            const viewport = document.querySelector('.door-viewport');
            const overlay = document.getElementById('doorOverlay');
            const mainContent = document.getElementById('mainContent');

            const doorSound = new Audio('Trial 4/audio/door.mp3');
            doorSound.play().catch(e => console.log("Audio diblokir browser, pastikan file ada: ", e));

            viewport.classList.add('opened');

            setTimeout(() => {
                overlay.style.opacity = '0';
                
                setTimeout(() => {
                    overlay.classList.add('hidden');
                    mainContent.classList.remove('hidden');
                    
                    isSnowing = true;
                    document.getElementById('snowCanvas').classList.add('active');
                    drawSnow();

                    window.scrollTo({ top: 0, behavior: 'instant' });

                    setTimeout(() => {
                        mainContent.classList.remove('opacity-0');
                    }, 50);
                    
                }, 800); 
            }, 1200); 
        }

        // ==========================================
        // COUNTDOWN TIMER LOGIC
        // ==========================================
        const targetDate = new Date("March 20, 2027 08:00:00").getTime(); 

        const updateCountdown = () => {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                document.getElementById("countdown").innerHTML = "<div class='col-span-4 text-center font-cinzel text-2xl text-gold-400 font-bold'>The Show Has Begun</div>";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("cd-days").innerText = days.toString().padStart(2, '0');
            document.getElementById("cd-hours").innerText = hours.toString().padStart(2, '0');
            document.getElementById("cd-minutes").innerText = minutes.toString().padStart(2, '0');
            document.getElementById("cd-seconds").innerText = seconds.toString().padStart(2, '0');
        };

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // ==========================================
        // ANGKATAN BUTTON SELECTION LOGIC
        // ==========================================
        const genButtons = document.querySelectorAll('.gen-btn');
        const angkatanInput = document.getElementById('angkatan');

        genButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                genButtons.forEach(b => {
                    b.classList.remove('bg-gold-400', 'text-emerald-950', 'border-gold-400');
                    b.classList.add('border-gold-500/30', 'text-gold-300');
                });
                btn.classList.remove('border-gold-500/30', 'text-gold-300');
                btn.classList.add('bg-gold-400', 'text-emerald-950', 'border-gold-400');
                angkatanInput.value = btn.getAttribute('data-val');
            });
        });

        // ==========================================
        // FUNGSI HANDLE FORM SUBMIT (DENGAN FORMSPREE)
        // ==========================================
        function handleFormSubmit(event) {
            event.preventDefault();
            
            if(!angkatanInput.value) {
                const msgBox = document.createElement('div');
                msgBox.className = "fixed top-4 left-1/2 transform -translate-x-1/2 bg-red-900/90 text-white px-6 py-3 rounded-full shadow-lg z-50 text-xs font-montserrat border border-red-500 uppercase tracking-widest";
                msgBox.innerText = "Please select your Generation (Angkatan).";
                document.body.appendChild(msgBox);
                setTimeout(() => msgBox.remove(), 3000);
                return;
            }

            const name = document.getElementById('guestName').value;
            const status = document.querySelector('input[name="attendance"]:checked').value;
            const count = document.getElementById('guestCount').value;
            const phone = document.getElementById('guestPhone').value;
            const message = document.getElementById('guestMessage').value;
            const code = document.getElementById('ticketCode').innerText;
            const angkatan = angkatanInput.value;

            // Efek tombol Loading
            const submitBtn = document.getElementById('submitBtn');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = "<i class='fa-solid fa-spinner fa-spin'></i> Sending...";
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-70', 'cursor-not-allowed');

            // Data untuk dikirim ke Formspree
            const formData = new FormData();
            formData.append("Nama Lengkap", name);
            formData.append("Angkatan", angkatan);
            formData.append("Status Kehadiran", status);
            formData.append("Jumlah Tamu", count);
            formData.append("Nomor WhatsApp", phone);
            formData.append("Pesan / Harapan", message);

            // Fetch ke Formspree URL Anda
            fetch("https://formspree.io/f/xbgdvanj", {
                method: "POST",
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    // Jika sukses kirim email, munculkan pop-up E-Ticket
                    document.getElementById('modalName').innerText = name;
                    document.getElementById('modalStatus').innerText = status;
                    document.getElementById('modalCount').innerText = count + " (Angkatan " + angkatan + ")";

                    document.getElementById('qrcode').innerHTML = ""; 
                    const qrData = `Ticket: ${code}\nName: ${name}\nAngkatan: ${angkatan}\nStatus: ${status}\nGuest: ${count}`;
                    
                    new QRCode(document.getElementById("qrcode"), {
                        text: qrData,
                        width: 130,
                        height: 130,
                        colorDark: "#031710",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });

                    const modal = document.getElementById('ticketModal');
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modal.classList.remove('opacity-0');
                        document.getElementById('modalCard').classList.remove('scale-95');
                    }, 10);
                    
                    // (Opsional) Kosongkan form setelah sukses
                    document.getElementById('rsvpForm').reset();
                    // Reset tombol angkatan
                    genButtons.forEach(b => {
                        b.classList.remove('bg-gold-400', 'text-emerald-950', 'border-gold-400');
                        b.classList.add('border-gold-500/30', 'text-gold-300');
                    });
                    angkatanInput.value = "";
                } else {
                    alert("Oops! Terjadi kesalahan saat mengirim data. Silakan coba lagi.");
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("Oops! Tidak dapat terhubung ke server (cek koneksi internet Anda).");
            })
            .finally(() => {
                // Kembalikan tombol ke kondisi semula
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            });
        }

        // ==========================================
        // FUNGSI MENUTUP MODAL
        // ==========================================
        function closeModal() {
            const modal = document.getElementById('ticketModal');
            modal.classList.add('opacity-0');
            document.getElementById('modalCard').classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // ==========================================
        // FUNGSI UNDUH E-TICKET (HTML2CANVAS)
        // ==========================================
        function downloadTicketImage() {
            const modalCard = document.getElementById('modalCard');
            const btnClose = document.getElementById('closeModalBtn');
            const btnDownload = document.getElementById('downloadBtn');
            const btnCopy = document.getElementById('copyBtn');
            
            btnClose.style.display = 'none';
            btnDownload.style.display = 'none';
            btnCopy.style.display = 'none';

            html2canvas(modalCard, { backgroundColor: '#031710' }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'e-ticket-bubaran-2027.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
                
                btnClose.style.display = 'flex';
                btnDownload.style.display = 'block';
                btnCopy.style.display = 'block';
            });
        }

        // ==========================================
        // FUNGSI SALIN RINGKASAN TIKET
        // ==========================================
        function copyTicketInfo() {
            const code = document.getElementById('ticketCode').innerText;
            const name = document.getElementById('modalName').innerText;
            const status = document.getElementById('modalStatus').innerText;
            const count = document.getElementById('modalCount').innerText;

            const textToCopy = `E-Ticket RSVP BUBARAN 2027\nTicket: ${code}\nName: ${name}\nStatus: ${status}\nGuest: ${count}`;
            
            navigator.clipboard.writeText(textToCopy).then(() => {
                const toast = document.getElementById('copyToast');
                toast.classList.remove('hidden');
                setTimeout(() => {
                    toast.classList.add('hidden');
                }, 2000);
            });
        }
    </script>
