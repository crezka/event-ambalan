            <p class="text-xs text-gold-200 font-playfair italic mb-6">Theme Row</p>

            <div class="bg-emerald-950/90 rounded-2xl p-4 border border-gold-500/30 text-left space-y-2 mb-6 text-xs">
                <div class="flex justify-between border-b border-emerald-900 pb-2"><span class="text-gray-400">Ticket Code:</span><span id="ticketCode" class="font-mono text-gold-300 font-bold">#BBRN-8821</span></div>
                <div class="flex justify-between border-b border-emerald-900 pb-2"><span class="text-gray-400">Guest Name:</span><span id="modalName" class="text-white font-semibold">-</span></div>
                <div class="flex justify-between border-b border-emerald-900 pb-2"><span class="text-gray-400">Status:</span><span id="modalStatus" class="text-gold-300 font-semibold">-</span></div>
                <div class="flex justify-between border-b border-emerald-900 pb-2"><span class="text-gray-400">Number of Guest:</span><span id="modalCount" class="text-white">-</span></div>
