<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RSVP BUBARAN - Theme Row</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Pustaka QR Code & html2canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        emerald: { 950: '#031710', 900: '#05291c', 800: '#09422e', 700: '#0f5c41', 600: '#157e5a' },
                        gold: { 100: '#fcf8e3', 300: '#f5e296', 400: '#ebd06a', 500: '#d4af37', 600: '#aa8822', 700: '#7e6212' }
                    },
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        montserrat: ['Montserrat', 'sans-serif'],
                        playfair: ['Playfair Display', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Styles & CSS 3D Door Animations */
        body { font-family: 'Montserrat', sans-serif; background-color: #031710; color: #f3f4f6; overflow-x: hidden; }
        .text-gold-gradient { background: linear-gradient(135deg, #fceabb 0%, #fccd4d 50%, #d4af37 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .gold-border-glow { border: 1px solid rgba(212, 175, 55, 0.35); box-shadow: 0 0 25px rgba(212, 175, 55, 0.12), inset 0 0 15px rgba(212, 175, 55, 0.05); }
        .glass-card { background: rgba(5, 41, 28, 0.65); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(212, 175, 55, 0.25); }
        
        .door-viewport { perspective: 1200px; perspective-origin: center center; }
        .door-wrapper { transform-style: preserve-3d; }
        .door-leaf { background: linear-gradient(135deg, #ffffff 0%, #f4f6f8 60%, #e2e8f0 100%); transition: transform 2.2s cubic-bezier(0.25, 1, 0.3, 1); transform-style: preserve-3d; box-shadow: inset 0 0 20px rgba(0,0,0,0.08), 0 10px 30px rgba(0,0,0,0.5); }
        .door-left { transform-origin: left center; }
        .door-right { transform-origin: right center; }
        
        .door-viewport.opened .door-left { transform: rotateY(-115deg); }
        .door-viewport.opened .door-right { transform: rotateY(115deg); }
        
        .door-panel { border: 3px solid #e2e8f0; box-shadow: inset 2px 2px 6px rgba(0,0,0,0.06), 2px 2px 4px rgba(255,255,255,0.9); border-radius: 4px; }
        .door-handle { background: linear-gradient(180deg, #fceabb 0%, #d4af37 50%, #aa8822 100%); box-shadow: 0 4px 10px rgba(0,0,0,0.3), inset 0 1px 2px rgba(255,255,255,0.8); }
        
        #snowCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 20; opacity: 0; transition: opacity 2s ease; }
        #snowCanvas.active { opacity: 1; }
        
        @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
        .btn-shimmer { background: linear-gradient(90deg, #d4af37 0%, #fff3c4 50%, #d4af37 100%); background-size: 200% 100%; animation: shimmer 3s infinite linear; }
        
        @keyframes floatSlow { 0%, 100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-10px) rotate(3deg); } }
        .animate-float { animation: floatSlow 6s ease-in-out infinite; }
    </style>
</head>
<body class="bg-emerald-950 text-gray-100 min-h-screen relative selection:bg-gold-500 selection:text-emerald-950">

    <canvas id="snowCanvas"></canvas>

    <!-- ========================================== -->
    <!-- INITIAL LANDING PAGE: 3D WHITE DOOR SCREEN -->
    <!-- ========================================== -->
    <div id="doorOverlay" class="fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-b from-[#020e0a] via-[#052218] to-[#020e0a] overflow-hidden transition-opacity duration-1000">
        <div class="absolute w-[90vw] max-w-[600px] h-[90vw] max-w-[600px] bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="door-viewport relative w-full max-w-lg h-[88vh] max-h-[780px] p-4 flex flex-col justify-center items-center">
            
            <div class="w-full max-w-md bg-gradient-to-r from-gold-700 via-gold-400 to-gold-700 h-3 rounded-t-lg shadow-lg relative z-30 mb-0 flex items-center justify-center">
                <div class="w-16 h-4 bg-gold-300 rounded-b-md shadow-md border-t border-gold-600"></div>
            </div>

            <div class="door-wrapper relative w-full max-w-md h-[80%] flex border-4 border-gold-600/60 rounded-b-lg overflow-hidden shadow-2xl bg-emerald-950/80">
                
                <!-- LEFT DOOR -->
                <div class="door-leaf door-left w-1/2 h-full border-r border-slate-300 flex flex-col justify-between p-4 sm:p-6 relative z-20">
                    <div class="door-panel w-full h-[45%] bg-slate-50 flex items-center justify-center relative"><div class="w-3/4 h-3/4 border border-slate-200 rounded"></div></div>
                    <div class="door-panel w-full h-[45%] bg-slate-50 flex items-center justify-center relative"><div class="w-3/4 h-3/4 border border-slate-200 rounded"></div></div>
                    <div class="absolute right-2 top-1/2 -translate-y-1/2 flex flex-col items-center gap-1 z-30">
                        <div class="w-3 h-12 door-handle rounded-full"></div>
                        <div class="w-2 h-2 bg-gold-700 rounded-full"></div>
                    </div>
                </div>

                <!-- RIGHT DOOR -->
                <div class="door-leaf door-right w-1/2 h-full border-l border-slate-300 flex flex-col justify-between p-4 sm:p-6 relative z-20">
                    <div class="door-panel w-full h-[45%] bg-slate-50 flex items-center justify-center relative"><div class="w-3/4 h-3/4 border border-slate-200 rounded"></div></div>
                    <div class="door-panel w-full h-[45%] bg-slate-50 flex items-center justify-center relative"><div class="w-3/4 h-3/4 border border-slate-200 rounded"></div></div>
                    <div class="absolute left-2 top-1/2 -translate-y-1/2 flex flex-col items-center gap-1 z-30">
                        <div class="w-3 h-12 door-handle rounded-full"></div>
                        <div class="w-2 h-2 bg-gold-700 rounded-full"></div>
                    </div>
                </div>

                <!-- INNER CONTENT -->
                <div class="absolute inset-0 z-10 flex flex-col items-center justify-center text-center p-6 bg-gradient-to-b from-emerald-900 via-emerald-950 to-black">
                    <i class="fa-solid fa-envelope-open-text text-gold-400 text-4xl mb-3 animate-bounce"></i>
                    <h3 class="font-cinzel text-xl text-gold-300 tracking-widest uppercase font-bold">Welcome</h3>
                    <p class="text-xs text-emerald-200 mt-2 font-montserrat tracking-wider">Preparing a Special Invitation...</p>
                </div>
            </div>

            <!-- Tombol Open Door -->
            <div class="mt-6 text-center z-30 flex flex-col items-center">
                <p class="text-xs tracking-[0.3em] uppercase text-gold-300 font-cinzel mb-1">YOU ARE CORDIALLY INVITED</p>
                <h1 class="font-cinzel font-black text-2xl sm:text-3xl text-gold-gradient tracking-wide mb-1">BUBARAN 2027</h1>
                <p class="font-playfair italic text-sm text-gold-200/90 mb-4">Theme Row</p>
                
                <button type="button" id="openDoorBtn" onclick="handleOpenDoor()" class="group relative inline-flex items-center gap-3 px-7 py-3 rounded-full btn-shimmer text-emerald-950 font-bold font-montserrat text-sm uppercase tracking-wider shadow-xl hover:scale-105 active:scale-95 transition-all duration-300">
                    <span>Open the door</span>
                    <i class="font-montserrat font-bold transition-transform duration-300 group-hover:translate-x-1"></i>
                </button>
            </div>

        </div>
    </div>

    <!-- ========================================== -->
    <!-- MAIN INVITATION CONTENT (REVEALED CONTENT) -->
    <!-- ========================================== -->
    <main id="mainContent" class="opacity-0 transition-opacity duration-1000 min-h-screen pb-20 relative z-10 hidden">

        <!-- Header -->
        <header class="sticky top-0 z-40 bg-emerald-950/80 backdrop-blur-md border-b border-gold-500/20 px-4 py-3">
            <div class="max-w-4xl mx-auto flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
                    <span class="font-cinzel font-bold text-lg text-gold-300 tracking-wider">RSVP BUBARAN</span>
                </div>
                <div class="text-xs font-cinzel text-gold-200 bg-emerald-900/80 px-3 py-1 rounded-full border border-gold-500/30">Theme Row</div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="relative pt-12 pb-16 px-4 text-center overflow-hidden">
            <div class="max-w-3xl mx-auto relative z-10">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl glass-card gold-border-glow mb-6 animate-float text-gold-400 text-2xl shadow-2xl">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
                <p class="text-xs sm:text-sm uppercase tracking-[0.4em] text-gold-300 font-cinzel mb-3">OFFICIAL INVITATION</p>
                <h1 class="font-cinzel font-black text-4xl sm:text-6xl tracking-tight text-gold-gradient mb-3 drop-shadow-md">BUBARAN 2027</h1>
                
                <div class="flex items-center justify-center gap-4 my-4">
                    <div class="h-[1px] w-12 bg-gradient-to-r from-transparent to-gold-400"></div>
                    <span class="font-playfair italic text-xl sm:text-2xl text-emerald-100 font-semibold tracking-wide">Theme Row</span>
                    <div class="h-[1px] w-12 bg-gradient-to-l from-transparent to-gold-400"></div>
                </div>

                <p class="text-gray-300 max-w-lg mx-auto text-sm sm:text-base leading-relaxed font-light mt-4">
                   We invite you to attend and strengthen the bonds of family at this gathering full of cherished memories.
                </p>

                <div class="mt-8 inline-block glass-card rounded-2xl px-8 py-5 gold-border-glow shadow-2xl relative">
                    <span class="text-xs font-cinzel uppercase text-gold-400 tracking-widest block mb-1">Save The Date!</span>
                    <div class="font-cinzel text-2xl sm:text-3xl font-bold text-white tracking-wider">
                        <span class="text-gold-300">xx</span> / <span class="text-gold-300">xx</span> / <span class="text-gold-300">xxxx</span>
                    </div>
                </div>

                <!-- TOMBOL NAVIGASI MENUJU RSVP -->
                <div class="mt-10">
                    <a href="#rsvpSection" class="inline-flex items-center gap-3 px-8 py-4 rounded-full border border-gold-400/50 bg-emerald-900/60 text-gold-300 font-bold font-montserrat text-xs uppercase tracking-wider shadow-lg hover:bg-gold-500 hover:text-emerald-950 hover:scale-105 active:scale-95 transition-all duration-300">
                        <i class="fa-solid fa-ticket"></i> Klik untuk Reservasi Tiket
                    </a>
                </div>

            </div>
        </section>

        <!-- Countdown Timer -->
        <section class="max-w-3xl mx-auto px-4 my-10" id="countdown-section">
            <div class="text-center mb-6">
                <h2 class="font-cinzel text-xl text-gold-300 tracking-widest uppercase">Towards the Peak Day</h2>
                <div class="w-16 h-[2px] bg-gold-500 mx-auto mt-2"></div>
            </div>
            <div class="grid grid-cols-4 gap-3 sm:gap-6 text-center" id="countdown">
                <div class="glass-card rounded-xl p-3 sm:p-4 border border-gold-500/30">
                    <span id="cd-days" class="font-cinzel font-bold text-2xl sm:text-4xl text-gold-300 block">xx</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-300 mt-1 block">Days</span>
                </div>
                <div class="glass-card rounded-xl p-3 sm:p-4 border border-gold-500/30">
                    <span id="cd-hours" class="font-cinzel font-bold text-2xl sm:text-4xl text-gold-300 block">xx</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-300 mt-1 block">Hours</span>
                </div>
                <div class="glass-card rounded-xl p-3 sm:p-4 border border-gold-500/30">
                    <span id="cd-minutes" class="font-cinzel font-bold text-2xl sm:text-4xl text-gold-300 block">xx</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-300 mt-1 block">Minutes</span>
                </div>
                <div class="glass-card rounded-xl p-3 sm:p-4 border border-gold-500/30">
                    <span id="cd-seconds" class="font-cinzel font-bold text-2xl sm:text-4xl text-gold-300 block">xx</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-300 mt-1 block">Seconds</span>
                </div>
            </div>
        </section>

        <!-- The Experience -->
        <section class="max-w-4xl mx-auto px-4 my-14">
            <div class="glass-card rounded-3xl p-6 sm:p-10 gold-border-glow grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <div class="md:col-span-5 flex justify-center">
                    <div class="relative w-full max-w-[280px] aspect-[3/4] rounded-2xl overflow-hidden border-2 border-gold-400/50 shadow-2xl bg-gradient-to-b from-emerald-900 via-emerald-800 to-emerald-950 flex flex-col justify-between p-6 text-center group">
                        <div class="absolute top-2 left-2 w-4 h-4 border-t-2 border-l-2 border-gold-400"></div>
                        <div class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-gold-400"></div>
                        <div class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-gold-400"></div>
                        <div class="absolute bottom-2 right-2 w-4 h-4 border-b-2 border-r-2 border-gold-400"></div>
                        <div class="pt-4">
                            <span class="text-[10px] tracking-[0.3em] font-cinzel text-gold-300 uppercase">EXCLUSIVE</span>
                            <h3 class="font-cinzel text-2xl font-bold text-white mt-1">Theme Row</h3>
                        </div>
                        <div class="my-auto py-6">
                            <div class="w-16 h-16 mx-auto rounded-full bg-gold-500/20 border border-gold-400 flex items-center justify-center text-gold-300 text-2xl mb-3"><i class="fa-solid fa-masks-theater"></i></div>
                            <p class="text-xs text-gold-200/90 italic font-playfair">"Unforgettable Togetherness"</p>
                        </div>
                        <div class="pb-2">
                            <span class="inline-block px-4 py-1 rounded-full text-[11px] font-semibold bg-gold-500 text-emerald-950 font-montserrat uppercase tracking-wider">RSVP BUBARAN</span>
                        </div>
                    </div>
                </div>
                <div class="md:col-span-7 space-y-4 text-center md:text-left">
                    <div class="inline-block px-3 py-1 rounded-full text-xs font-cinzel text-gold-300 bg-emerald-900/60 border border-gold-500/30">Highlight Events</div>
                    <h2 class="font-cinzel text-2xl sm:text-3xl font-bold text-gold-gradient">The Theme Row Experience</h2>
                    <p class="text-gray-300 text-sm leading-relaxed font-light">
                        Event <strong class="text-gold-300 font-semibold">BUBARAN 2027: Theme Row</strong> dirancang khusus sebagai ruang reuni dan perayaan yang elegan. Menghadirkan suasana hangat, santap bersama, sesi foto, serta hiburan yang akan membawa kita kembali pada momen-momen berharga.
                    </p>
                    <div class="pt-2 flex flex-wrap justify-center md:justify-start gap-4 text-xs text-gold-200">
                        <div class="flex items-center gap-2 bg-emerald-900/40 px-3 py-2 rounded-lg border border-gold-500/20"><i class="fa-solid fa-utensils text-gold-400"></i><span>Banquet</span></div>
                        <div class="flex items-center gap-2 bg-emerald-900/40 px-3 py-2 rounded-lg border border-gold-500/20"><i class="fa-solid fa-camera text-gold-400"></i><span>Photo Session</span></div>
                        <div class="flex items-center gap-2 bg-emerald-900/40 px-3 py-2 rounded-lg border border-gold-500/20"><i class="fa-solid fa-music text-gold-400"></i><span>Entertainment</span></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Event Details -->
        <section class="max-w-4xl mx-auto px-4 my-14">
            <div class="text-center mb-8">
                <h2 class="font-cinzel text-2xl font-bold text-gold-gradient tracking-wide uppercase">Event Details</h2>
                <p class="text-xs text-emerald-200 font-montserrat mt-1">Time & Location</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                <!-- Card 1 -->
                <div class="glass-card rounded-2xl p-5 text-center border border-gold-500/30 hover:border-gold-400 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-400/40 text-gold-400 flex items-center justify-center text-xl mx-auto mb-3 group-hover:scale-110 transition-transform"><i class="fa-regular fa-calendar-check"></i></div>
                    <span class="text-xs uppercase tracking-widest text-gold-300 font-cinzel block mb-1">Date</span>
                    <h3 class="font-cinzel text-lg font-bold text-white">xx / xx / xxxx</h3>
                    <p class="text-xs text-gray-400 mt-1">Day: xx</p>
                </div>
                <!-- Card 2 -->
                <div class="glass-card rounded-2xl p-5 text-center border border-gold-500/30 hover:border-gold-400 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-400/40 text-gold-400 flex items-center justify-center text-xl mx-auto mb-3 group-hover:scale-110 transition-transform"><i class="fa-regular fa-clock"></i></div>
                    <span class="text-xs uppercase tracking-widest text-gold-300 font-cinzel block mb-1">Time</span>
                    <h3 class="font-cinzel text-lg font-bold text-white">xx : xx WIB</h3>
                    <p class="text-xs text-gray-400 mt-1">s/d Selesai</p>
                </div>
                <!-- Card 3 -->
                <div class="glass-card rounded-2xl p-5 text-center border border-gold-500/30 hover:border-gold-400 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-400/40 text-gold-400 flex items-center justify-center text-xl mx-auto mb-3 group-hover:scale-110 transition-transform"><i class="fa-solid fa-location-dot"></i></div>
                    <span class="text-xs uppercase tracking-widest text-gold-300 font-cinzel block mb-1">Place</span>
                    <h3 class="font-cinzel text-lg font-bold text-white">xx</h3>
                    <p class="text-xs text-gray-400 mt-1">Venue: xx</p>
                </div>
                <!-- Card 4 -->
                <div class="glass-card rounded-2xl p-5 text-center border border-gold-500/30 hover:border-gold-400 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-400/40 text-gold-400 flex items-center justify-center text-xl mx-auto mb-3 group-hover:scale-110 transition-transform"><i class="fa-solid fa-shirt"></i></div>
                    <span class="text-xs uppercase tracking-widest text-gold-300 font-cinzel block mb-1">Dresscode</span>
                    <h3 class="font-cinzel text-lg font-bold text-white">xx</h3>
                    <p class="text-xs text-gray-400 mt-1">Theme: Theme Row</p>
                </div>
            </div>
        </section>

        <!-- RSVP Form Section -->
        <section id="rsvpSection" class="max-w-2xl mx-auto px-4 my-16 pt-10">
            <div class="glass-card rounded-3xl p-6 sm:p-10 gold-border-glow shadow-2xl relative">
                <div class="text-center mb-8">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-cinzel text-gold-300 bg-emerald-900/80 border border-gold-500/30 mb-2">
                        <i class="fa-solid fa-ticket text-gold-400"></i> Confirm Attendance
                    </div>
                    <h2 class="font-cinzel text-2xl sm:text-3xl font-bold text-gold-gradient">YOUR TICKET DETAILS</h2>
                    <p class="text-xs text-gray-300 mt-1 font-light">Please fill in your personal data to claim the official BUBARAN 2027 ticket</p>
                </div>

                <form id="rsvpForm" onsubmit="handleFormSubmit(event)" class="space-y-5">
                    <div>
                        <label class="block text-xs uppercase font-cinzel tracking-wider text-gold-300 mb-2">Full Name <span class="text-red-400">*</span></label>
                        <input type="text" id="guestName" required placeholder="Masukkan nama lengkap Anda" class="w-full px-4 py-3 rounded-xl bg-emerald-950/80 border border-gold-500/30 text-white placeholder-gray-500 focus:outline-none focus:border-gold-400 focus:ring-1 focus:ring-gold-400 text-sm transition-all">
                    </div>

                    <div>
                        <label class="block text-xs uppercase font-cinzel tracking-wider text-gold-300 mb-2">Confirm Attendance <span class="text-red-400">*</span></label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="attendance" value="Hadir Tepat Waktu" checked class="peer sr-only">
                                <div class="py-2.5 px-3 rounded-xl border border-gold-500/30 bg-emerald-950/60 text-center text-xs font-montserrat text-gray-300 peer-checked:border-gold-400 peer-checked:bg-gold-500/20 peer-checked:text-gold-300 transition-all h-full flex flex-col justify-center"><i class="fa-solid fa-check circle mb-1 block text-sm"></i> Hadir Tepat Waktu</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="attendance" value="Terlambat" class="peer sr-only">
                                <div class="py-2.5 px-3 rounded-xl border border-gold-500/30 bg-emerald-950/60 text-center text-xs font-montserrat text-gray-300 peer-checked:border-gold-400 peer-checked:bg-gold-500/20 peer-checked:text-gold-300 transition-all h-full flex flex-col justify-center"><i class="fa-solid fa-clock circle mb-1 block text-sm"></i> Terlambat</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="attendance" value="Ragu" class="peer sr-only">
                                <div class="py-2.5 px-3 rounded-xl border border-gold-500/30 bg-emerald-950/60 text-center text-xs font-montserrat text-gray-300 peer-checked:border-gold-400 peer-checked:bg-gold-500/20 peer-checked:text-gold-300 transition-all h-full flex flex-col justify-center"><i class="fa-solid fa-question circle mb-1 block text-sm"></i> Tidak Tahu</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="attendance" value="Tidak Hadir" class="peer sr-only">
                                <div class="py-2.5 px-3 rounded-xl border border-gold-500/30 bg-emerald-950/60 text-center text-xs font-montserrat text-gray-300 peer-checked:border-gold-400 peer-checked:bg-gold-500/20 peer-checked:text-gold-300 transition-all h-full flex flex-col justify-center"><i class="fa-solid fa-xmark circle mb-1 block text-sm"></i> Tidak Hadir</div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-6">
